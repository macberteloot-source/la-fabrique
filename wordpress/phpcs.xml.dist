<?xml version="1.0"?>
<ruleset name="La Fabrique">
	<description>WordPress Coding Standards (WPCS 3) pour le code PHP de La Fabrique : plugins, mu-plugins, thème, scripts et tests.</description>

	<file>./wp-content/plugins/fabrique-recettes</file>
	<file>./wp-content/plugins/fabrique-boutique</file>
	<file>./wp-content/mu-plugins</file>
	<file>./wp-content/themes/la-fabrique</file>
	<file>./bin</file>
	<file>./tests</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.5"/>

	<rule ref="WordPress"/>

	<!-- Un text domain par composant : plugins et thème. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="fabrique-recettes"/>
				<element value="fabrique-boutique"/>
				<element value="la-fabrique"/>
			</property>
		</properties>
	</rule>

	<!-- Préfixes du projet : fonctions fabrique_ / la_fabrique_, espaces de noms Fabrique\…, constantes FABRIQUE_. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="fabrique"/>
				<element value="la_fabrique"/>
				<element value="Fabrique"/>
			</property>
		</properties>
	</rule>

	<!-- Les scripts de test lancés par « wp eval-file » ne sont pas du code de production. -->
	<rule ref="WordPress.PHP.DevelopmentFunctions">
		<exclude-pattern>*/tests/*</exclude-pattern>
		<exclude-pattern>*/bin/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
</ruleset>
