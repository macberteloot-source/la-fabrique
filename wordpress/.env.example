# Copier en .env (« make up » le fait s'il manque). Valeurs de développement uniquement : ne pas réutiliser en production.

# Ports exposés sur la machine
WP_PORT=8080
MAILPIT_PORT=8025

# Base de données (conteneur db)
DB_NAME=fabrique
DB_USER=fabrique
DB_PASSWORD=fabrique-dev
DB_ROOT_PASSWORD=racine-dev

# Installation (bin/setup.sh)
WP_URL=http://localhost:8080
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin123
WP_ADMIN_EMAIL=bonjour@la-fabrique.test

# Connexion avec Google : identifiant client OAuth « Application Web » (origine autorisée : http://localhost:8080).
# Vide = bouton masqué. Prioritaire sur le réglage WooCommerce → La Fabrique.
FABRIQUE_GOOGLE_CLIENT_ID=
